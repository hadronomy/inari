<odoo>
    <record id="ir_cron_inari_reconcile" model="ir.cron">
        <field name="name">Inari: synchronize Controller inventory</field>
        <field name="model_id" ref="model_inari_setup_state"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_inventory()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
    <record id="ir_cron_inari_webhook_retention" model="ir.cron">
        <field name="name">Inari: purge webhook replay records</field>
        <field name="model_id" ref="model_inari_webhook_delivery"/>
        <field name="state">code</field>
        <field name="code">model.purge_expired()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>
