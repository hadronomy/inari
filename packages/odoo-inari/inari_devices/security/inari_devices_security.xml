<odoo>
    <record id="privilege_inari_devices" model="res.groups.privilege">
        <field name="name">Inari Devices</field>
        <field name="category_id" ref="base.module_category_operations"/>
        <field name="sequence">40</field>
    </record>
    <record id="privilege_inari_system" model="res.groups.privilege">
        <field name="name">Inari System</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_inari_operator" model="res.groups">
        <field name="name">Operator</field>
        <field name="privilege_id" ref="inari_devices.privilege_inari_devices"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_inari_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="inari_devices.privilege_inari_devices"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('inari_devices.group_inari_operator'))]"/>
    </record>
    <record id="group_inari_admin" model="res.groups">
        <field name="name">System Administrator</field>
        <field name="privilege_id" ref="inari_devices.privilege_inari_devices"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('inari_devices.group_inari_manager'))]"/>
    </record>
    <record id="group_inari_sync" model="res.groups">
        <field name="name">Projection Sync</field>
        <field name="privilege_id" ref="inari_devices.privilege_inari_system"/>
    </record>

    <record id="rule_inari_company_operator" model="ir.rule">
        <field name="name">Inari records: company</field>
        <field name="model_id" ref="model_inari_device"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('inari_devices.group_inari_operator'))]"/>
    </record>
    <record id="rule_inari_company_organization" model="ir.rule"><field name="name">Inari Organizations: company</field><field name="model_id" ref="model_inari_organization"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('inari_devices.group_inari_manager'))]"/></record>
    <record id="rule_inari_company_site" model="ir.rule"><field name="name">Inari Sites: company</field><field name="model_id" ref="model_inari_site"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('inari_devices.group_inari_manager'))]"/></record>
    <record id="rule_inari_company_agent" model="ir.rule"><field name="name">Inari Agents: company</field><field name="model_id" ref="model_inari_agent"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('inari_devices.group_inari_manager'))]"/></record>
